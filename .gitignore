# ==========================================
# Dependencies & Package Managers
# ==========================================
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Turborepo & Build Outputs
# ==========================================
.turbo/
dist/
build/
out/
*.tsbuildinfo

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Exception: keep template/example env files if you create them
!.env.example

# ==========================================
# Prisma & Databases
# ==========================================
# Ignore local SQLite/dev databases if used
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# ==========================================
# Expo & React Native (apps/mobile)
# ==========================================
.expo/
.expo-shared/
web-build/
*.pfx
*.keystore
*.orig.*

# Native generated folders (if using bare workflow or prebuild)
apps/mobile/android/
apps/mobile/ios/

# ==========================================
# NestJS & Backend (apps/api)
# ==========================================
# Nest compilation output is handled by dist/ above, but listed for clarity
apps/api/dist/

# ==========================================
# Editors & System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/